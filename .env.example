# Copy to .env and adjust. docker-compose.yaml has safe development defaults for every
# value below, so .env is optional for local Docker use. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_SUPERUSER_PASSWORD=postgres_dev
TASKTRACK_OWNER_PASSWORD=tasktrack_owner_dev
TASKTRACK_APP_PASSWORD=tasktrack_app_dev
# Used when running Django on the host (outside Docker). Compose overrides these.
DATABASE_URL=postgres://tasktrack_app:tasktrack_app_dev@localhost:4000/tasktrack
DATABASE_OWNER_URL=postgres://tasktrack_owner:tasktrack_owner_dev@localhost:4000/tasktrack

# --- Redis / Celery ---
REDIS_URL=redis://localhost:4001/0
CELERY_BROKER_URL=redis://localhost:4001/1

# --- Auth ---
JWT_SIGNING_KEY=change-me-separate-from-django-secret
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=14
REFRESH_COOKIE_SECURE=false
INVITE_EXPIRY_HOURS=48
PASSWORD_RESET_EXPIRY_MINUTES=60
# Fernet key for TOTP secrets: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- File storage ---
# false (default): attachments and exports are stored under MEDIA_ROOT and served
# only through permission-checked API endpoints.
# true: S3 API with pre-signed URLs. Local store: docker compose --profile s3 up -d
USE_S3=false
MEDIA_ROOT=./backend/media
S3_ACCESS_KEY=tasktrack
S3_SECRET_KEY=tasktrack-s3-dev
S3_BUCKET=tasktrack
S3_ENDPOINT_URL=http://localhost:9000
# Host name used inside pre-signed URLs; must be reachable from the browser.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
ATTACHMENT_MAX_MB=25

# --- Email ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=TaskTrack <no-reply@tasktrack.local>

# --- Web ---
WEB_ORIGIN=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3001

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
