DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Runtime connects as the restricted role (no BYPASSRLS). Host is localhost when running Django outside Docker.
DATABASE_URL=postgres://tasktrack_app:tasktrack_app_dev@localhost:5432/tasktrack
REDIS_URL=redis://localhost:6379/0